{
  "name": "agy-statusline",
  "version": "1.0.0",
  "description": "White Minimal custom statusline for Google Antigravity CLI (AGY) with zero external dependencies",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "agy-statusline": "./bin/agy-statusline.js"
  },
  "scripts": {
    "test": "node tests/run-tests.js",
    "setup": "node scripts/install.js",
    "uninstall": "node scripts/uninstall.js",
    "notify:test": "node scripts/test-notify.js",
    "notify:on": "node scripts/toggle-notify.js on",
    "notify:off": "node scripts/toggle-notify.js off",
    "notify:toggle": "node scripts/toggle-notify.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
}
